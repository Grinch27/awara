<?xml version="1.0" encoding="utf-8"?>
<!-- Requirements: credentials, account data, logs and paths never enter automatic backups.
     User-selected safe JSON export remains available in Settings. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
